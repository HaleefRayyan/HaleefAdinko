# Backend API URL for production deployment.
# Change this to your Railway app URL before deploying frontend to Vercel.
VITE_API_URL=https://your-backend-production-url.up.railway.app

# If you prefer to use a Vite proxy instead of CORS, add this to vite.config.js:
