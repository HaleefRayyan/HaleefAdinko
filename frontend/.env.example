# Copy to .env and edit the URL to your backend server (used by ContactForm and other API calls)
# Example: VITE_API_URL=http://localhost:3306
VITE_API_URL=http://localhost:3306

# If you prefer to use a Vite proxy instead of CORS, add this to vite.config.js:
